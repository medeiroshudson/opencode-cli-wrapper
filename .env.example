# --- OpenCode serve daemon ------------------------------------------------
# Absolute path or command name of the `opencode` binary used to spawn the
# supervised `opencode serve` daemon.
OPENCODE_BIN=opencode

# Loopback port the supervised `opencode serve` daemon listens on.
OPENCODE_PORT=4100

# Base URL of an existing `opencode serve` API to use instead of spawning one.
# When set it overrides OPENCODE_PORT; leave unset to spawn and supervise a
# local daemon on 127.0.0.1:OPENCODE_PORT.
# OPENCODE_BASE=http://127.0.0.1:4100

# Per-request wall-clock timeout for a single serve HTTP request (ms).
OPENCODE_TIMEOUT_MS=120000

# Maximum time to wait for the supervised daemon to become healthy (ms).
OPENCODE_SERVE_READY_TIMEOUT_MS=20000

# --- HTTP server ----------------------------------------------------------
PORT=3000
HOST=0.0.0.0
API_KEY=

# How long to cache the catalog discovered from the serve API (ms).
OPENCODE_MODELS_TTL_MS=300000

# --- Outbound proxy (opencode serve) --------------------------------------
# Route the supervised daemon's outbound requests through a proxy. Leave unset
# to connect directly.
# OPENCODE_PROXY_URL=http://proxy.corp:8080
#
# TLS/CA (passed through the environment):
# NODE_EXTRA_CA_CERTS=/etc/ssl/certs/corp-ca.pem
