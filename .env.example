# --- OpenCode serve daemon ------------------------------------------------
# Absolute path or command name of the `opencode` binary used to spawn the
# supervised `opencode serve` daemon.
OPENCODE_BIN=opencode

# Port the wrapper spawns and supervises its own `opencode serve` daemon on.
# Ignored when OPENCODE_BASE names a port on a loopback host.
OPENCODE_PORT=4100

# Base URL of the `opencode serve` API the wrapper talks to. Leave unset to spawn
# and supervise a local daemon on 127.0.0.1:OPENCODE_PORT. A loopback URL (e.g.
# http://127.0.0.1:9999) makes the wrapper supervise the daemon on that URL's
# port. A non-loopback URL is used as-is: the wrapper never spawns a local daemon
# for it and reports a clear startup error when it is unhealthy.
# OPENCODE_BASE=http://127.0.0.1:4100

# Wall-clock timeout for a serve HTTP request (ms). For the streaming event
# stream it is an IDLE timeout: the deadline re-arms on every event, so a long
# generation is never cut while a silent stream still aborts.
OPENCODE_TIMEOUT_MS=120000

# Maximum time to wait for the supervised daemon to become healthy (ms).
OPENCODE_SERVE_READY_TIMEOUT_MS=20000

# --- HTTP server ----------------------------------------------------------
PORT=3000
HOST=0.0.0.0
API_KEY=

# How long to cache the catalog discovered from the serve API (ms).
OPENCODE_MODELS_TTL_MS=300000

# --- Outbound proxy (opencode serve) --------------------------------------
# Route the supervised daemon's outbound requests through a proxy. Leave unset
# to connect directly.
# OPENCODE_PROXY_URL=http://proxy.corp:8080
#
# TLS/CA (passed through the environment):
# NODE_EXTRA_CA_CERTS=/etc/ssl/certs/corp-ca.pem
